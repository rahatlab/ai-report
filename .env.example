# ============================================================
#  AI CSV Report - Environment Variables
#  Copy this file to `.env.local` and fill in your values.
#  On Vercel: put these in Project Settings -> Environment Variables
# ============================================================

# ---- Site login password (visitor er jonno) ----
APP_PASSWORD=0000

# ---- Session secret (production-e ekta long random string banao) ----
SESSION_SECRET=change-me-to-a-long-random-string-please

# ---- AI provider: "gemini" OR "groq" ----
AI_PROVIDER=gemini

# ---- Report language: "en" OR "bn" (Bangla) ----
REPORT_LANG=en

# ---- Google Gemini (FREE key -> https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Groq (FREE key -> https://console.groq.com/keys) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
